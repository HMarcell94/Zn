                                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource TextHint}" FontSize="12" Margin="0,3,0,0"/>
                                                        <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                                                 FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="&#xE838;" Style="{StaticResource GhostIconButton}" ToolTip="Megnyitás a mappában" Click="HistoryShowInFolder_Click"/>
                                                        <Button Content="&#xE71B;" Style="{StaticResource GhostIconButton}" Margin="4,0,0,0" ToolTip="Link másolása" Click="HistoryCopyLink_Click"/>
                                                        <Button Content="&#xE74D;" Style="{StaticResource GhostIconButton}" Margin="4,0,0,0" ToolTip="Eltávolítás az előzményekből" Click="HistoryRemove_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                    <Setter TargetName="StatusIcon" Property="Text" Value="&#xE711;"/>
                                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource AccentPink}"/>
                                                    <Setter TargetName="StatusTile" Property="Background" Value="#24FF3D9E"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- ===== Console (log + progress) ===== -->
                <Border x:Name="ConsoleCard" Grid.Row="2" Margin="40,0,40,20" MaxWidth="1100" CornerRadius="16"
                        Background="{StaticResource ConsoleBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Height="3" Margin="16,0">
                            <ProgressBar x:Name="GlobalProgressBar" Style="{StaticResource NeonProgress}" Minimum="0" Maximum="100" IsIndeterminate="True" Visibility="Collapsed"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="16,6,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE756;" Style="{StaticResource IconGlyph}" FontSize="12" Foreground="{StaticResource AccentPink}"/>
                                <TextBlock Text="NAPLÓ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextHint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="CopyLogButton" Content="&#xE8C8;" Style="{StaticResource GhostIconButton}" Click="CopyLogButton_Click" ToolTip="Napló másolása a vágólapra"/>
                                <Button x:Name="ClearLogButton" Content="&#xE74D;" Style="{StaticResource GhostIconButton}" Click="ClearLogButton_Click" ToolTip="Napló törlése"/>
                                <Button x:Name="ConsoleToggleButton" Content="&#xE70D;" Style="{StaticResource GhostIconButton}" Click="ConsoleToggleButton_Click" ToolTip="Napló összecsukása"/>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="StatusLog" Grid.Row="2" Style="{StaticResource LogTextBox}" Margin="18,0,14,14" MaxHeight="118"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 Text="Üdv! Válassz egy eszközt bal oldalt a kezdéshez."/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
