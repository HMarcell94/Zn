<Window x:Class="ZnDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ZnDownloader"
        mc:Ignorable="d"
        Title="Zn Tools" Height="760" Width="1160" MinHeight="600" MinWidth="760"
        FontFamily="Segoe UI Variable Text, Segoe UI" Icon="pack://application:,,,/icon.ico"
        WindowStyle="None" ResizeMode="CanResize" Background="#0B0616"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ===================== TOKENS ===================== -->
        <SolidColorBrush x:Key="TextPrimary" Color="#F7F2FF"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#C9BBE0"/>
        <SolidColorBrush x:Key="TextHint"    Color="#8F80AB"/>
        <SolidColorBrush x:Key="AccentPink"  Color="#FF3D9E"/>
        <SolidColorBrush x:Key="AccentViolet" Color="#B14EFF"/>
        <SolidColorBrush x:Key="AccentCyan"  Color="#34D9F0"/>
        <SolidColorBrush x:Key="InputBg"     Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="InputBorder" Color="#29FFFFFF"/>
        <SolidColorBrush x:Key="Hairline"    Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBg"   Color="#C2140C24"/>
        <SolidColorBrush x:Key="SidebarBg"   Color="#B30B0617"/>
        <SolidColorBrush x:Key="ConsoleBg"   Color="#C70A0613"/>

        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF3D9E" Offset="0"/>
            <GradientStop Color="#B14EFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF5CB4" Offset="0"/>
            <GradientStop Color="#C46BFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF3D9E" Offset="0"/>
            <GradientStop Color="#B14EFF" Offset="0.6"/>
            <GradientStop Color="#34D9F0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardBorder" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3DFFFFFF" Offset="0"/>
            <GradientStop Color="#0DFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavSelectedBg" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#33FF3D9E" Offset="0"/>
            <GradientStop Color="#0AB14EFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Page side margins; Window_SizeChanged swaps this for a tighter one on narrow windows. -->
        <Thickness x:Key="PageMargin">40,0,40,28</Thickness>

        <!-- Slow drift of the background light orbs (started from code, paused when minimised). -->
        <Storyboard x:Key="BackdropDrift" Timeline.DesiredFrameRate="30">
            <DoubleAnimation Storyboard.TargetName="Orb1Move" Storyboard.TargetProperty="X" From="0" To="110" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Orb1Move" Storyboard.TargetProperty="Y" From="0" To="70" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Orb2Move" Storyboard.TargetProperty="X" From="0" To="-120" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Orb2Move" Storyboard.TargetProperty="Y" From="0" To="90" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Orb3Move" Storyboard.TargetProperty="X" From="0" To="140" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Orb3Move" Storyboard.TargetProperty="Y" From="0" To="-60" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ===================== TYPOGRAPHY ===================== -->
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentPink}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextHint}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextHint}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextHint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="2,8,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Collapses in the narrow (icon-only) sidebar -->
        <Style x:Key="HideWhenCompact" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="local:Ui.IsCompact" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShowWhenCompact" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <Trigger Property="local:Ui.IsCompact" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== SURFACES ===================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="24,22"/>
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#24FF3D9E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PageScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="PageStack" TargetType="StackPanel">
            <Setter Property="Margin" Value="{DynamicResource PageMargin}"/>
            <Setter Property="MaxWidth" Value="1100"/>
        </Style>

        <!-- ===================== SCROLLBAR (slim) ===================== -->
        <ControlTemplate x:Key="SlimThumb" TargetType="Thumb">
            <Border x:Name="t" CornerRadius="3" Background="#3DFFFFFF"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="t" Property="Background" Value="#73FFFFFF"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="t" Property="Background" Value="{StaticResource AccentPink}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,4">
                            <Track.Thumb>
                                <Thumb Template="{StaticResource SlimThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,3">
                                    <Track.Thumb>
                                        <Thumb Template="{StaticResource SlimThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== TOOLTIP ===================== -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F2180F29" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TEXTBOX (placeholder via Tag) ===================== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentPink}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentPink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <Grid>
                                <!-- No Margin here: the text view already applies the TextBox's Padding itself. -->
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextHint}" FontSize="13.5"
                                           Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#59FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPink}"/>
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Read-only, selectable log: select / copy with mouse, Ctrl+A, Ctrl+C or right-click. -->
        <Style x:Key="LogTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentPink}"/>
            <Setter Property="SelectionOpacity" Value="0.45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Same, without its own ScrollViewer, so the mouse wheel still scrolls the surrounding list. -->
        <Style x:Key="SelectableText" TargetType="TextBox" BasedOn="{StaticResource LogTextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Decorator x:Name="PART_ContentHost"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== COMBOBOX ===================== -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="tb" Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="11">
                <TextBlock x:Name="chev" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="tb" Property="BorderBrush" Value="#59FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource AccentPink}"/>
                    <Setter TargetName="chev" Property="Foreground" Value="{StaticResource AccentPink}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggleTemplate}" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="15,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#F7180F2A" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="12" Margin="0,6,0,12" Padding="0,4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.55"/>
                                    </Border.Effect>
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Margin="5,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FF3D9E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4DFF3D9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== WINDOW CONTROL BUTTONS ===================== -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E8264F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small transparent icon button (console, history rows) -->
        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FF3D9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== PRIMARY BUTTON (icon via local:Ui.Icon) ===================== -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="glow" CornerRadius="14" Background="{StaticResource AccentGradient}" Opacity="0.5" Margin="10,10,10,-4">
                                <Border.Effect>
                                    <BlurEffect Radius="20"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="bg" CornerRadius="14" Background="{StaticResource AccentGradient}">
                                <Border CornerRadius="14" BorderThickness="1" BorderBrush="#40FFFFFF"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="icon" Text="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:Ui.Icon" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentGradientHover}"/>
                                <Setter TargetName="glow" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== SECONDARY / ICON BUTTONS ===================== -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <TextBlock x:Name="icon" Text="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:Ui.Icon" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#24FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#59FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- ===================== CONVERTER FORMAT CHIP ===================== -->
        <Style x:Key="FormatButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fb" Property="BorderBrush" Value="#73FFFFFF"/>
                            </Trigger>
                            <!-- Not compatible with the chosen input -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fb" Property="Opacity" Value="0.28"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== DROP ZONE (click to browse, or drop a file) ===================== -->
        <Style x:Key="DropZone" TargetType="Button">
            <Setter Property="MinHeight" Value="164"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="frame" RadiusX="14" RadiusY="14" Fill="#08FFFFFF" Stroke="#47FFFFFF" StrokeThickness="1.3" StrokeDashArray="5 4"/>
                            <ContentPresenter Margin="20,18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="Stroke" Value="{StaticResource AccentPink}"/>
                                <Setter TargetName="frame" Property="Fill" Value="#12FF3D9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== SEGMENTED CONTROL ===================== -->
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style x:Key="SegmentItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="10" Background="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock x:Name="icon" Text="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:Ui.Icon" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="bg" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentGradient}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF3D9E" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== SIDEBAR NAV ITEM ===================== -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="12" Background="Transparent"/>
                            <Border x:Name="bar" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource AccentGradient}" Opacity="0"/>
                            <StackPanel x:Name="content" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0">
                                <TextBlock x:Name="glyph" Text="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="label" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource NavSelectedBg}"/>
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource AccentPink}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="local:Ui.IsCompact" Value="True">
                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="content" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="content" Property="Margin" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Tooltips only make sense when the labels are hidden -->
                <Trigger Property="local:Ui.IsCompact" Value="False">
                    <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== TABS: headers hidden, the sidebar drives selection ===================== -->
        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- ===================== PROGRESS (thin neon line) ===================== -->
        <Style x:Key="NeonProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="#1AFFFFFF" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource AccentGradientH}" CornerRadius="2"/>
                            <Rectangle x:Name="Sweep" Visibility="Collapsed" RadiusX="2" RadiusY="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-1"/>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#00FF3D9E" Offset="0"/>
                                        <GradientStop Color="#FFFF3D9E" Offset="0.4"/>
                                        <GradientStop Color="#FFB14EFF" Offset="0.6"/>
                                        <GradientStop Color="#00B14EFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Sweep" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="SweepRun">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Sweep"
                                                             Storyboard.TargetProperty="(Shape.Fill).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                             From="-1" To="1" Duration="0:0:1.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SweepRun"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===================== ROOT ===================== -->
    <Grid x:Name="RootLayout">

        <!-- ============ ABSTRACT BACKDROP ============ -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.55*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0B0616" Offset="0"/>
                        <GradientStop Color="#130A25" Offset="0.64"/>
                        <GradientStop Color="#1A0B2B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Light orbs -->
            <Ellipse Grid.RowSpan="2" Width="880" Height="880" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-300,-380,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Orb1Move"/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#70FF3D9E" Offset="0"/>
                        <GradientStop Color="#24FF3D9E" Offset="0.45"/>
                        <GradientStop Color="#00FF3D9E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Grid.RowSpan="2" Width="1000" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-220,-420,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Orb2Move"/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#66A24BFF" Offset="0"/>
                        <GradientStop Color="#1FA24BFF" Offset="0.5"/>
                        <GradientStop Color="#00A24BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Grid.RowSpan="2" Width="640" Height="640" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="160,0,0,-320">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Orb3Move"/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4D34D9F0" Offset="0"/>
                        <GradientStop Color="#1434D9F0" Offset="0.5"/>
                        <GradientStop Color="#0034D9F0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Abstract synthwave sun, sliced and sinking into the horizon -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,-340">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55FF3D9E" Offset="0"/>
                            <GradientStop Color="#00FF3D9E" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="320" Height="320" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,180,-100" Opacity="0.5">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFC46B" Offset="0"/>
                            <GradientStop Color="#FF3D9E" Offset="0.55"/>
                            <GradientStop Color="#B14EFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="0.48"/>
                            <GradientStop Color="#00000000" Offset="0.48"/>
                            <GradientStop Color="#00000000" Offset="0.51"/>
                            <GradientStop Color="#FF000000" Offset="0.51"/>
                            <GradientStop Color="#FF000000" Offset="0.57"/>
                            <GradientStop Color="#00000000" Offset="0.57"/>
                            <GradientStop Color="#00000000" Offset="0.61"/>
                            <GradientStop Color="#FF000000" Offset="0.61"/>
                            <GradientStop Color="#FF000000" Offset="0.66"/>
                            <GradientStop Color="#00000000" Offset="0.66"/>
                            <GradientStop Color="#00000000" Offset="0.71"/>
                            <GradientStop Color="#FF000000" Offset="0.71"/>
                            <GradientStop Color="#FF000000" Offset="0.75"/>
                            <GradientStop Color="#00000000" Offset="0.75"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.OpacityMask>
                </Ellipse>
            </Grid>

            <!-- Perspective grid floor -->
            <Viewbox Grid.Row="1" Stretch="Fill" Opacity="0.5">
                <Viewbox.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="0.55"/>
                        <GradientStop Color="#AA000000" Offset="1"/>
                    </LinearGradientBrush>
                </Viewbox.OpacityMask>
                <Canvas Width="1000" Height="300" ClipToBounds="True">
                    <Path Stroke="#FF3D9E" StrokeThickness="1"
                          Data="M500,0 L-1320,300 M500,0 L-1190,300 M500,0 L-1060,300 M500,0 L-930,300 M500,0 L-800,300 M500,0 L-670,300 M500,0 L-540,300 M500,0 L-410,300 M500,0 L-280,300 M500,0 L-150,300 M500,0 L-20,300 M500,0 L110,300 M500,0 L240,300 M500,0 L370,300 M500,0 L500,300 M500,0 L630,300 M500,0 L760,300 M500,0 L890,300 M500,0 L1020,300 M500,0 L1150,300 M500,0 L1280,300 M500,0 L1410,300 M500,0 L1540,300 M500,0 L1670,300 M500,0 L1800,300 M500,0 L1930,300 M500,0 L2060,300 M500,0 L2190,300 M500,0 L2320,300"/>
                    <Path Stroke="#B14EFF" StrokeThickness="1"
                          Data="M0,6 L1000,6 M0,18 L1000,18 M0,36 L1000,36 M0,60 L1000,60 M0,90 L1000,90 M0,126 L1000,126 M0,168 L1000,168 M0,216 L1000,216 M0,270 L1000,270"/>
                </Canvas>
            </Viewbox>
            <!-- Horizon glow line -->
            <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Top" Opacity="0.7">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FF3D9E" Offset="0"/>
                        <GradientStop Color="#FFFF3D9E" Offset="0.7"/>
                        <GradientStop Color="#00FF3D9E" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Vignette keeps the edges calm and text readable -->
            <Rectangle Grid.RowSpan="2">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.55,0.42" GradientOrigin="0.55,0.42" RadiusX="0.85" RadiusY="0.9">
                        <GradientStop Color="#00000000" Offset="0.5"/>
                        <GradientStop Color="#99050210" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ============ APP SHELL ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar (collapses to an icon rail on narrow windows) ===== -->
            <Border x:Name="Sidebar" Width="236" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand (also a drag handle) -->
                    <Grid Height="88" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="19,0,0,0">
                            <Grid Width="38" Height="38">
                                <Border CornerRadius="12" Background="{StaticResource AccentGradient}" Opacity="0.7" Margin="2,4,2,-2">
                                    <Border.Effect><BlurEffect Radius="14"/></Border.Effect>
                                </Border>
                                <Border CornerRadius="12" Background="{StaticResource AccentGradient}">
                                    <TextBlock Text="Zn" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center" Style="{StaticResource HideWhenCompact}">
                                <TextBlock Text="Zn Tools" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Média eszköztár" FontSize="11.5" Foreground="{StaticResource TextHint}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="ESZKÖZÖK" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextHint}" Margin="28,4,0,8"
                               Style="{StaticResource HideWhenCompact}"/>

                    <StackPanel x:Name="NavPanel" Grid.Row="2" Margin="12,0">
                        <RadioButton Style="{StaticResource NavItem}" Tag="0" local:Ui.Icon="&#xE714;" Content="YouTube" ToolTip="YouTube" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="1" local:Ui.Icon="&#xE840;" Content="Pinterest" ToolTip="Pinterest" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="2" local:Ui.Icon="&#xE8A3;" Content="Felskálázás" ToolTip="Felskálázás" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="3" local:Ui.Icon="&#xE895;" Content="Konvertálás" ToolTip="Konvertálás" Checked="Nav_Checked"/>

                        <TextBlock Text="KÖNYVTÁR" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextHint}" Margin="16,20,0,8"
                                   Style="{StaticResource HideWhenCompact}"/>
                        <Border Height="1" Background="{StaticResource Hairline}" Margin="10,14" Style="{StaticResource ShowWhenCompact}"/>

                        <RadioButton Style="{StaticResource NavItem}" Tag="4" local:Ui.Icon="&#xE81C;" Content="Előzmények" ToolTip="Előzmények" Checked="Nav_Checked"/>
                    </StackPanel>

                    <!-- Tool status -->
                    <Border x:Name="ToolsStatusCard" Grid.Row="4" Margin="12,0,12,16" CornerRadius="12" Background="#0FFFFFFF" Padding="14,11">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse x:Name="ToolsStatusGlow" Width="10" Height="10" Fill="{StaticResource AccentCyan}" Opacity="0.5">
                                    <Ellipse.Effect><BlurEffect Radius="6"/></Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="ToolsStatusDot" Width="7" Height="7" Fill="{StaticResource AccentCyan}"/>
                            </Grid>
                            <TextBlock x:Name="ToolsStatusText" Text="Eszközök ellenőrzése…" FontSize="11.5" Foreground="{StaticResource TextHint}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"
                                       Style="{StaticResource HideWhenCompact}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Content column ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar: drag area + window controls -->
                <Grid Height="44" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click" ToolTip="Kis méret"/>
                        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowControlButton}" Click="MaximizeButton_Click" ToolTip="Teljes méret"/>
                        <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="Bezárás"/>
                    </StackPanel>
                </Grid>

                <!-- Pages -->
                <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                            SelectionChanged="MainTabControl_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TabPanel IsItemsHost="True"/>
                                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- ============ PAGE 1: YOUTUBE ============ -->
                    <TabItem>
                        <ScrollViewer Style="{StaticResource PageScroll}">
                            <StackPanel Style="{StaticResource PageStack}">
                                <TextBlock Text="LETÖLTÉS" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="YouTube" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Zene vagy videó letöltése egy YouTube link alapján." Style="{StaticResource PageSubtitle}"/>

                                <local:AdaptiveColumnsPanel BreakWidth="760" Spacing="18" Margin="0,26,0,0">
                                    <!-- Source -->
                                    <Border Style="{StaticResource Card}" local:AdaptiveColumnsPanel.Weight="1.35">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border Style="{StaticResource IconTile}">
                                                    <TextBlock Text="&#xE71B;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="{StaticResource AccentPink}"/>
                                                </Border>
                                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Forrás" Style="{StaticResource CardTitle}"/>
                                                    <TextBlock Text="Mit és honnan töltsön le az app" Style="{StaticResource CardSubtitle}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <TextBlock Text="MIT SZERETNÉL LETÖLTENI?" Style="{StaticResource FieldLabel}"/>
                                            <Border Style="{StaticResource SegmentHost}">
                                                <UniformGrid Rows="1">
                                                    <RadioButton x:Name="YtAudioModeRadio" GroupName="YtMode" Style="{StaticResource SegmentItem}" local:Ui.Icon="&#xE8D6;"
                                                                 Content="Zene (audió)" IsChecked="True" Checked="YtMode_Checked"/>
                                                    <RadioButton x:Name="YtVideoModeRadio" GroupName="YtMode" Style="{StaticResource SegmentItem}" local:Ui.Icon="&#xE714;"
                                                                 Content="Videó" Checked="YtMode_Checked"/>
                                                </UniformGrid>
                                            </Border>

                                            <TextBlock Text="YOUTUBE LINK" Style="{StaticResource FieldLabel}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="YtUrlTextBox" Tag="https://www.youtube.com/watch?v=..."/>
                                                <Button x:Name="YtPasteButton" Grid.Column="1" Content="&#xE77F;" Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0"
                                                        Click="YtPasteButton_Click" ToolTip="Beillesztés a vágólapról"/>
                                            </Grid>
                                            <TextBlock Text="Hanghoz az app sztereó sávot választ, így a hosszú WAV-ok is kezelhető méretűek maradnak." Style="{StaticResource HintText}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Output -->
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <Border Style="{StaticResource IconTile}" Background="#2434D9F0">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="{StaticResource AccentCyan}"/>
                                                </Border>
                                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Kimenet" Style="{StaticResource CardTitle}"/>
                                                    <TextBlock Text="Formátum és mentési hely" Style="{StaticResource CardSubtitle}"/>
                                                </StackPanel>
                                            </DockPanel>

